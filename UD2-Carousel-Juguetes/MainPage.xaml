<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD2_Carousel_Juguetes.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="25" BackgroundColor="CornflowerBlue">

            <Label 
                Text="Catálogo de Juguetes"
                FontAttributes="Bold"
                FontSize="32"
                TextColor="White"
                HorizontalOptions="Center" />

            <CarouselView x:Name="carouselToys" CurrentItem="{Binding SelectedToy}"
              IndicatorView="indicatorView" BackgroundColor="White">

                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <StackLayout>
                                <!-- Nombre -->
                                <Label Text="{Binding NameToy}"/>

                                <!-- Imagen -->
                                <Image Source="{Binding ImageToy}" HeightRequest="150" Aspect="AspectFit"/>

                                <!-- Edad -->
                                <Label Text="{Binding AgeRecommended, StringFormat='Edad Recomendada {0} años'}"/>

                                <!-- Precio -->

                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="indicatorView" HorizontalOptions="Center"
               IndicatorColor="LightGray"
               SelectedIndicatorColor="#3498DB"/>

            <Border Stroke="Gray" StrokeThickness="1" Padding="10" BackgroundColor="White">
                <StackLayout>
                    <Label Text="Detalles del Juguete Seleccionado" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>
                    <Label Text="{Binding SelectedToy.PriceToy, StringFormat='Precio: ${0:F2}'}"/>
                </StackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
